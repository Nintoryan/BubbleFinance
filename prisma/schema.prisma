// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id        String   @id @default(uuid())
  name      String
  currency  String   // USD | RSD | RUB | VND | EUR
  color     String   @default("#4F46E5")
  icon      String   @default("wallet")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions      Transaction[] @relation("TransactionFromAccount")
  transactionsTo    Transaction[] @relation("TransactionToAccount")

  @@map("accounts")
}

model Category {
  id        String   @id @default(uuid())
  name      String
  type      String   // INCOME | EXPENSE
  color     String          @default("#6B7280")
  icon      String          @default("tag")
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  transactions Transaction[]

  @@unique([name, type])
  @@map("categories")
}

model Transaction {
  id         String   @id @default(uuid())
  type       String   // INCOME | EXPENSE | CONVERSION
  accountId  String   // для INCOME/EXPENSE - основной счёт, для CONVERSION - счёт откуда (fromAccount)
  categoryId String?  // опционально, не требуется для CONVERSION
  amount     Int      // для INCOME/EXPENSE - сумма, для CONVERSION - сумма откуда (fromAmount)
  currency   String   // для INCOME/EXPENSE - валюта, для CONVERSION - валюта откуда (fromCurrency)
  date       DateTime
  note       String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  // Поля для конвертации (опциональные)
  toAccountId String? // счёт куда (только для CONVERSION)
  toAmount    Int?     // сумма куда в минимальных единицах (только для CONVERSION)
  toCurrency  String?  // валюта куда (только для CONVERSION)

  account   Account   @relation("TransactionFromAccount", fields: [accountId], references: [id], onDelete: Restrict)
  toAccount Account?  @relation("TransactionToAccount", fields: [toAccountId], references: [id], onDelete: Restrict)
  category  Category? @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@map("transactions")
}

model Settings {
  id          Int      @id @default(1)
  baseCurrency String  @default("USD") // USD | RSD | RUB | VND | EUR
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("settings")
}

